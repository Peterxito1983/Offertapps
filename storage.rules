rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura a cualquier usuario autenticado en todo el bucket
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Reglas específicas para escritura
    match /offers/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /companies/logos/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /users/avatars/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
