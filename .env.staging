# Variables de entorno para staging
# No incluir credenciales directamente en el código fuente

# Configuración de Firebase para staging
VITE_FIREBASE_API_KEY=clave_api_staging
VITE_FIREBASE_AUTH_DOMAIN=offertapps-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=offertapps-staging
VITE_FIREBASE_STORAGE_BUCKET=offertapps-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789013
VITE_FIREBASE_APP_ID=1:123456789013:web:abcdef1234567890abcdeg
VITE_FIREBASE_MEASUREMENT_ID=G-YYYYYYYYYY
VITE_FIREBASE_DATABASE_URL=https://offertapps-staging-default-rtdb.firebaseio.com/

# API Keys para staging
VITE_GEMINI_API_KEY=clave_gemini_staging

# Otras configuraciones de staging
NODE_ENV=staging